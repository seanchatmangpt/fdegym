{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fdegym:schema:operation-manifest:1",
  "title": "FDE Gym Cloud Operation Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider", "source", "services"],
  "properties": {
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "source_version": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "services": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
